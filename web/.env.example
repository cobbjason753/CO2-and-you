# --- Required ---
# Postgres connection string. Neon free tier: copy the *pooled* connection string.
DATABASE_URL=postgres://postgres@localhost:5432/cobsci
# Optional: direct (non-pooled) connection, used by `npm run migrate`. Neon: the URL without -pooler.
DATABASE_URL_UNPOOLED=
# 32+ random characters. Encrypts device secrets and signs nothing else; never change it once devices enroll.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string
# Public URL of this app (used in emails and claim QR codes)
APP_URL=http://localhost:3000

# --- Email (optional; without it, emails are only stored in the Admin > Emails outbox) ---
RESEND_API_KEY=
EMAIL_FROM="CO2 & You <hello@cobsci.com>"
SUPPORT_EMAIL=support@cobsci.com

# --- Stripe (optional; test-mode keys are free) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUBSCRIPTION=

# --- Scheduled jobs: callers must send  Authorization: Bearer $CRON_SECRET ---
CRON_SECRET=change-me-too
